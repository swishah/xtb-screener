# Skopiuj do .env.local i uzupełnij, żeby czytać z bazy zdalnej.
#
# BEZ tych zmiennych frontend czyta lokalny plik ../data/history.db — czyli
# zamrożoną kopię z repo. Wygodne przy pracy na własnym komputerze, ale na
# produkcji oznacza dane sprzed migracji.
#
# Dla frontendu wygeneruj w Turso token TYLKO DO ODCZYTU. Frontend niczego nie
# zapisuje, więc token z prawem zapisu byłby niepotrzebnym ryzykiem.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
