# Skopiuj do .env.local (praca lokalna) albo wklej w panelu hostingu.

# --- TRYB ZDALNY (produkcja) -------------------------------------------------
# Gdy oba są ustawione, frontend czyta bazę Turso.
#
# Dla frontendu wygeneruj token TYLKO DO ODCZYTU. Aplikacja niczego nie
# zapisuje, więc token z prawem zapisu byłby niepotrzebnym ryzykiem — gdyby
# wyciekł, pozwoliłby skasować historię migawek.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- TRYB LOKALNY (zapasowy) -------------------------------------------------
# Bez zmiennych powyżej frontend czyta plik SQLite. Domyślnie szuka go
# w ../data/history.db względem katalogu roboczego, co działa przy
# `npm run dev`, ale NIE w paczce produkcyjnej: serwer standalone startuje
# z .next/standalone, więc ścieżka wskazywałaby w złe miejsce.
#
# Dlatego przy uruchamianiu paczki standalone (i kiedyś w kontenerze na NAS-ie)
# podaj ścieżkę wprost:
# SCIEZKA_BAZY=/data/history.db
SCIEZKA_BAZY=
